# Space Analyzer Pro - Environment Configuration
# Copy to .env and adjust as needed. All values have sensible defaults.

# --- Server ---
PORT=8091
HOST=localhost
NODE_ENV=development
CORS_ORIGIN=*

# --- Database ---
DATABASE_PATH=./server/knowledge.db
DB_MAX_CONNECTIONS=10
DB_TIMEOUT=30000

# --- File Scanning ---
MAX_SCAN_DEPTH=10
MAX_FILE_SIZE=104857600
ALLOWED_EXTENSIONS=.js,.ts,.tsx,.jsx,.vue,.json,.md,.html,.css,.scss,.py,.rs,.go,.java,.cpp,.c,.h

# --- AI / Ollama ---
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
DEFAULT_AI_MODEL=gemma3:latest
VISION_MODEL=qwen2.5vl:7b
AI_TIMEOUT=60000
AI_MAX_RETRIES=3
AI_MODELS=gemma3:latest,qwen2.5vl:7b

# --- AI Python Service ---
PYTHON_AI_PORT=5000
AI_SERVICE_URL=http://127.0.0.1:5000

# --- Features ---
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_DUPLICATE_DETECTION=true
ENABLE_REALTIME_UPDATES=false
ENABLE_ADVANCED_SEARCH=true
ENABLE_EXPORT=true
ENABLE_MONITORING=true

# --- Security ---
JWT_SECRET=change-me-in-production
SESSION_TIMEOUT=86400000
ENABLE_HTTPS=false
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# --- Logging ---
LOG_LEVEL=debug
LOG_FILE=server.log
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5
LOG_CONSOLE=true
LOG_FILE_ENABLE=true

# --- Performance ---
ENABLE_COMPRESSION=true
ENABLE_CACHING=true
CACHE_SIZE=100
WORKER_THREADS=2
MAX_MEMORY=536870912

# --- Notifications (optional) ---
# GITHUB_TOKEN=
# DISCORD_WEBHOOK=
# SLACK_WEBHOOK=
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_FROM=
